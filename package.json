{
  "name": "@evojewel/fethr",
  "version": "0.5.0-alpha",
  "publishConfig": {
    "access": "public"
  },
  "description": "A featherweight code editor with a first-class agent panel. Local server + your browser as the shell, CodeMirror core, Claude-powered agent that proposes \u2014 never writes. No Electron.",
  "keywords": [
    "editor",
    "lightweight",
    "agent",
    "claude-code"
  ],
  "homepage": "https://github.com/evojewel/fethr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evojewel/fethr.git"
  },
  "license": "MIT",
  "author": "Jewel Lukose",
  "type": "module",
  "bin": {
    "fethr": "bin/fethr.js"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.238",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "codemirror": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "esbuild web/editor.js --bundle --format=esm --minify --outfile=dist/editor.js && cp web/index.html dist/index.html",
    "prepublishOnly": "npm run build"
  }
}